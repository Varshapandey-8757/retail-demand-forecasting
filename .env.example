APP_NAME=Retail Demand Forecasting API
APP_ENV=development
API_PREFIX=/api/v1

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=retail_analytics

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/retail_forecasting_db
API_BASE_URL=http://127.0.0.1:8000

# Optional API/dashboard authentication. Leave both blank for local development.
VIEWER_API_KEY=replace-with-viewer-key
ADMIN_API_KEY=replace-with-admin-key